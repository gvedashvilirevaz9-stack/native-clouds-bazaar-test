{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "node build.mjs",
  "outputDirectory": "web",
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 30,
      "includeFiles": "api/_lib/*.json"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "regions": [
    "fra1"
  ]
}
